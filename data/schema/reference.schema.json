{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overblaze.github.io/dndf-platform/schema/reference.schema.json",
  "title": "A chapter of a reference book",
  "description": "A chapter of a freely licensed rulebook kept for looking things up (data/reference). Nothing here is offered when building a character: that is data/rules.",
  "type": "object",
  "required": ["$schemaVersion", "$note", "book", "chapter", "page", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schemaVersion": { "const": 1 },
    "$note": { "type": "string", "minLength": 40, "description": "The licence attribution the book asks for." },
    "book": { "type": "string", "minLength": 1 },
    "chapter": { "type": "string", "minLength": 1 },
    "page": { "type": "integer", "minimum": 1 },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "page": { "type": "integer", "minimum": 1 },
    "entry": {
      "type": "object",
      "required": ["id", "name", "kind", "page", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^srd52\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
        "name": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["section", "class", "background", "species", "feat", "gear", "spell", "term", "magicItem", "monster"] },
        "page": { "$ref": "#/$defs/page" },
        "section": { "$ref": "#/$defs/text" },
        "group": { "$ref": "#/$defs/text" },
        "subtitle": { "$ref": "#/$defs/text" },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "rows": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["t", "level", "text", "page"],
          "additionalProperties": false,
          "properties": { "t": { "const": "h" }, "level": { "type": "integer", "minimum": 1, "maximum": 5 }, "text": { "$ref": "#/$defs/text" }, "page": { "$ref": "#/$defs/page" } }
        },
        {
          "type": "object",
          "required": ["t", "text", "page"],
          "additionalProperties": false,
          "properties": { "t": { "enum": ["p", "stat"] }, "text": { "$ref": "#/$defs/text" }, "lead": { "$ref": "#/$defs/text" }, "page": { "type": "integer", "minimum": 0 } }
        },
        {
          "type": "object",
          "required": ["t", "rows", "page"],
          "additionalProperties": false,
          "properties": {
            "t": { "const": "table" },
            "title": { "$ref": "#/$defs/text" },
            "rows": { "$ref": "#/$defs/rows" },
            "wide": { "const": true },
            "head": { "const": false, "description": "Present when the first row is not a header." },
            "over": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["text", "from", "to"],
                "additionalProperties": false,
                "properties": { "text": { "$ref": "#/$defs/text" }, "from": { "type": "integer", "minimum": 0 }, "to": { "type": "integer", "minimum": 0 } }
              }
            },
            "notes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
            "page": { "$ref": "#/$defs/page" }
          }
        },
        {
          "type": "object",
          "required": ["t", "rows", "page"],
          "additionalProperties": false,
          "properties": { "t": { "const": "facts" }, "rows": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } } }, "page": { "$ref": "#/$defs/page" } }
        },
        {
          "type": "object",
          "required": ["t", "rows", "page"],
          "additionalProperties": false,
          "properties": { "t": { "const": "abilities" }, "rows": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "minLength": 1 } } }, "page": { "$ref": "#/$defs/page" } }
        },
        {
          "type": "object",
          "required": ["t", "title", "text", "page"],
          "additionalProperties": false,
          "properties": { "t": { "const": "sidebar" }, "title": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" }, "page": { "$ref": "#/$defs/page" } }
        }
      ]
    }
  }
}
