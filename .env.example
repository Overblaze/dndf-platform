# Copy to .env.local (never committed) and fill in from Supabase:
# Project Settings -> API. Both values are safe to ship to the browser.
# Never put the service-role key, or any Discord secret, in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
